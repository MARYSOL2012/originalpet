<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGradient3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7ED321;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#FF8C42;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4A90E2;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cardGradient3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#f8f9fa;stop-opacity:0.9" />
    </linearGradient>
  </defs>
  
  <!-- Fondo con gradiente -->
  <rect width="512" height="512" fill="url(#bgGradient3)"/>
  
  <!-- Tarjeta principal -->
  <rect x="50" y="100" width="412" height="312" rx="20" fill="url(#cardGradient3)" stroke="#fff" stroke-width="2"/>
  
  <!-- Escudo de confianza central -->
  <path d="M256 150 L300 200 L300 280 L256 330 L212 280 L212 200 Z" fill="#4A90E2" stroke="#2C3E50" stroke-width="3"/>
  <text x="256" y="250" text-anchor="middle" fill="white" font-family="Arial" font-size="48" font-weight="bold">🛡️</text>
  
  <!-- Manos estrechándose -->
  <circle cx="180" cy="200" r="30" fill="#FF8C42" opacity="0.8"/>
  <rect x="170" y="230" width="20" height="40" fill="#2C3E50"/>
  <rect x="165" y="270" width="30" height="15" fill="#34495e"/>
  
  <circle cx="332" cy="200" r="30" fill="#7ED321" opacity="0.8"/>
  <rect x="322" y="230" width="20" height="40" fill="#2C3E50"/>
  <rect x="317" y="270" width="30" height="15" fill="#34495e"/>
  
  <!-- Mascotas confiadas -->
  <ellipse cx="150" cy="350" rx="25" ry="20" fill="#8B4513"/>
  <circle cx="140" cy="340" r="6" fill="#000"/>
  <circle cx="160" cy="340" r="6" fill="#000"/>
  <ellipse cx="150" cy="360" rx="15" ry="6" fill="#000"/>
  
  <ellipse cx="350" cy="350" rx="20" ry="18" fill="#FFA500"/>
  <circle cx="345" cy="342" r="5" fill="#000"/>
  <circle cx="355" cy="342" r="5" fill="#000"/>
  <ellipse cx="350" cy="358" rx="12" ry="5" fill="#000"/>
  
  <!-- Elementos de seguridad -->
  <rect x="80" y="120" width="60" height="40" rx="5" fill="#7ED321" opacity="0.8"/>
  <text x="110" y="145" text-anchor="middle" fill="white" font-family="Arial" font-size="12" font-weight="bold">SEGURIDAD</text>
  
  <rect x="370" y="120" width="60" height="40" rx="5" fill="#FF6B6B" opacity="0.8"/>
  <text x="400" y="145" text-anchor="middle" fill="white" font-family="Arial" font-size="12" font-weight="bold">AMOR</text>
  
  <!-- Iconos de confianza -->
  <circle cx="120" cy="250" r="20" fill="#4A90E2" opacity="0.9"/>
  <text x="120" y="255" text-anchor="middle" fill="white" font-family="Arial" font-size="18">🤝</text>
  
  <circle cx="380" cy="250" r="20" fill="#7ED321" opacity="0.9"/>
  <text x="380" y="255" text-anchor="middle" fill="white" font-family="Arial" font-size="18">❤️</text>
  
  <circle cx="120" cy="320" r="20" fill="#FF8C42" opacity="0.9"/>
  <text x="120" y="325" text-anchor="middle" fill="white" font-family="Arial" font-size="18">🔒</text>
  
  <circle cx="380" cy="320" r="20" fill="#FF6B6B" opacity="0.9"/>
  <text x="380" y="325" text-anchor="middle" fill="white" font-family="Arial" font-size="18">⭐</text>
  
  <!-- Líneas de conexión -->
  <line x1="180" y1="200" x2="256" y2="200" stroke="#4A90E2" stroke-width="3" opacity="0.7"/>
  <line x1="332" y1="200" x2="256" y2="200" stroke="#7ED321" stroke-width="3" opacity="0.7"/>
  <line x1="256" y1="280" x2="150" y2="350" stroke="#FF8C42" stroke-width="2" opacity="0.6"/>
  <line x1="256" y1="280" x2="350" y2="350" stroke="#FF8C42" stroke-width="2" opacity="0.6"/>
  
  <!-- Título -->
  <text x="256" y="80" text-anchor="middle" fill="white" font-family="Arial" font-size="24" font-weight="bold">GENERAR CONFIANZA</text>
  <text x="256" y="450" text-anchor="middle" fill="white" font-family="Arial" font-size="16" opacity="0.9">Seguridad y amor por los animales</text>
</svg>
